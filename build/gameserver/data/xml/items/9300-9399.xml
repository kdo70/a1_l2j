<?xml version="1.0" encoding="UTF-8"?>
<list>
	<!--
		The raid boss book. Right clicking it opens the window generated by the RaidBookManager - see
		docs/raidboss-book.md.

		The book is bound to this item by the "handler" attribute alone, so moving that single line
		onto another item moves the book with it. Which is what has to be done as long as the client
		doesn't know this id : Interlude reads the icon and the name of an item out of its own
		etcitemgrp.dat and itemname-e.dat, and this one ends at 9208.
	-->
	<item id="9300" type="EtcItem" name="Raid Boss Book">
		<set name="default_action" val="show_html" />
		<set name="material" val="PAPER" />
		<set name="weight" val="10" />
		<set name="price" val="0" />
		<set name="is_dropable" val="false" />
		<set name="is_sellable" val="false" />
		<set name="is_destroyable" val="false" />
		<set name="handler" val="RaidBossBook" />
	</item>
</list>
