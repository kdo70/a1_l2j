<?xml version="1.0" encoding="UTF-8"?>
<list>
	<!--
		The raid boss book. Right clicking it opens the window generated by the RaidBookManager - see
		docs/raidboss-book.md.

		It is handed automatically, once, the first time its owner lays a hand on a raid boss, and it
		is bound to this very id by "RaidBookItemId" of config/mods/raidbook.properties. What actually
		opens the window is the "handler" attribute below, so moving that single line onto another
		item - and pointing RaidBookItemId at it - moves the book with it. Which is what has to be
		done as long as the client doesn't know this id : Interlude reads the icon and the name of an
		item out of its own etcitemgrp.dat and itemname-e.dat, and this one ends at 9208.

		The book is bound to its owner : it can't be sold, dropped, traded, warehoused nor destroyed.
		Every one of those five flags is needed - dropping one of them leaves that very way out open.
	-->
	<item id="9300" type="EtcItem" name="Raid Boss Book">
		<set name="default_action" val="show_html" />
		<set name="material" val="PAPER" />
		<set name="weight" val="0" />
		<set name="price" val="0" />
		<set name="is_sellable" val="false" />
		<set name="is_dropable" val="false" />
		<set name="is_tradable" val="false" />
		<set name="is_depositable" val="false" />
		<set name="is_destroyable" val="false" />
		<set name="handler" val="RaidBossBook" />
	</item>
</list>
